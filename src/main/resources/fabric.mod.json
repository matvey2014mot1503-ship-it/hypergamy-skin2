    "client": ["hypergamy.HypergamyClient"]
  },
  "mixins": ["hypergamy.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.4",
    "java": ">=21"
  }
}
